
@{
    ViewData["Title"] = "Контакти";
}
<div class="contact-page">
    <div class="container py-5">
        <h1 class="text-center mb-4">Свържете се с нас</h1>

        <div class="row mb-5">
            <div class="col-md-6">
                <h4>Кои са SisiPartyAgency?</h4>
                <p>
                    Ние сме млада, креативна агенция, създадена с много любов към празниците!
                    Организираме незабравими събития, осигуряваме стилна декорация и ви помагаме да създадете спомени, които остават завинаги.
                </p>

                <h5 class="mt-4">Контакти</h5>
                <ul class="list-unstyled">
                    <li><i class="fas fa-phone-alt me-2 text-pink"></i> 0896 727305</li>
                    <li><i class="fas fa-envelope me-2 text-pink"></i> info@eventagency.bg</li>
                    <li><i class="fas fa-map-marker-alt me-2 text-pink"></i>гр. Перник , ул. Христо Ботев 3</li>
                    <li>
                        <i class="fab fa-facebook me-2 text-pink"></i>
                        <a href="https://www.facebook.com/profile.php?id=61577112029292" target="_blank">SisiPartyAgency</a>
                    </li>
                </ul>

                <div class="col-md-6">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2936.893437708224!2d23.01869077598313!3d42.600004371171615!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14aaca93b1e7d4b3%3A0x533d5bedea447516!2sVarosh%2C%20ul.%20%22Hristo%20Botev%22%203%2C%202300%20Pernik!5e0!3m2!1sen!2sbg!4v1754477439382!5m2!1sen!2sbg" width="100%" height="280"
                            style="border: 2px solid #ffc107; border-radius: 10px; box-shadow: 0 4px 12px rgba(255,193,7,0.3);"
                            allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>



            <div class="col-md-6">
                <h4>Изпратете ни съобщение</h4>
                <form method="post" action="https://formspree.io/f/xzzvakdr">
                    <div class="mb-3">
                        <label for="name" class="form-label">Име</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Имейл</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="message" class="form-label">Съобщение</label>
                        <textarea name="message" class="form-control" rows="5" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-pink">Изпрати</button>
                </form>
            </div>
        </div>

        <hr />
    </div>
</div>


