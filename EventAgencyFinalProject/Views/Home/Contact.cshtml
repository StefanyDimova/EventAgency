
@{
    ViewData["Title"] = "Контакти";
}
<div class="contact-page">
    <div class="container py-5">
        <h1 class="text-center mb-4">Свържете се с нас</h1>

        <div class="row mb-5">
            <div class="col-md-6">
                <h4>Кои са SisiPartyAgency?</h4>
                <p>
                    Ние сме млада, креативна агенция, създадена с много любов към празниците!
                    Организираме незабравими събития, осигуряваме стилна декорация и ви помагаме да създадете спомени, които остават завинаги.
                </p>

                <h5 class="mt-4">Контакти</h5>
                <ul class="list-unstyled">
                    <li><i class="fas fa-phone-alt me-2 text-pink"></i> 0896 727305</li>
                    <li><i class="fas fa-envelope me-2 text-pink"></i> contact@sisiparty.bg</li>
                    <li><i class="fas fa-map-marker-alt me-2 text-pink"></i> ул. Веселба 22, София</li>
                    <li>
                        <i class="fab fa-facebook me-2 text-pink"></i>
                        <a href="https://facebook.com/sisipartyagency" target="_blank">SisiPartyAgency</a>
                    </li>
                </ul>
            </div>



            <div class="col-md-6">
                <h4>Изпратете ни съобщение</h4>
                <form method="post" action="https://formspree.io/f/xzzvakdr">
                    <div class="mb-3">
                        <label for="name" class="form-label">Име</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Имейл</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="message" class="form-label">Съобщение</label>
                        <textarea name="message" class="form-control" rows="5" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-pink">Изпрати</button>
                </form>
            </div>
        </div>

        <hr />
    </div>
</div>


