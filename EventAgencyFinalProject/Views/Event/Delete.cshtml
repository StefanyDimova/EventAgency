@using EventAgency.Web.ViewModels.Event
@model DeleteEventViewModel
@{
    ViewData["Title"] = "Потвърди изтриване";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0 p-4 rounded" style="background-color: #fff0f6;">
                <div class="row g-4">
                    <div class="col-md-5 d-flex align-items-center">
                        <img src="@Model.ImageUrl" alt="@Model.Name"
                             class="img-fluid rounded shadow border border-3 border-white w-100" />
                    </div>

                    <div class="col-md-7">
                        <h2 class="text-danger fw-bold mb-3">@Model.Name</h2>


                        <p class="fs-5 fw-semibold text-dark">
                            Сигурни ли сте, че искате да изтриете това събитие?
                        </p>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="d-flex gap-3 mt-4">
                                <button type="submit" class="btn btn-danger btn-delete-confirm px-4 py-2 fw-bold rounded-pill">
                                    <i class="fas fa-trash-alt me-2"></i> Потвърди
                                </button>

                                <a asp-action="Details" asp-route-id="@Model.Id"
                                   class="btn btn-outline-secondary btn-delete-cancel px-4 py-2 fw-bold rounded-pill">
                                    <i class="fas fa-arrow-left me-2"></i> Назад
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .btn-delete-confirm {
            background-color: #dc3545; /* danger */
            border: none;
            color: white;
        }

        .btn-delete-cancel {
            background-color: #f8f9fa;
            border: 2px solid #6c757d;
            color: #333;
        }

        .btn-delete-confirm:hover {
            background-color: #bb2d3b;
        }

        .btn-delete-cancel:hover {
            background-color: #e2e6ea;
            border-color: #5a6268;
        }

        .card {
            background-color: #fff0f6 !important;
        }

        body {
            background-color: #f9f4f1;
        }

        .mt-4 {
            margin: 1.5rem !important;
        }
    </style>
}
