@model EventAgency.Web.ViewModels.EventReservation.EventReservationRequestInputModel

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Calendar</title>

    <!-- Зареждаме CSS за jQuery UI Datepicker -->
    <link href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" rel="stylesheet">

    <!-- Зареждаме jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Зареждаме jQuery UI (за Datepicker) -->
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>

    <style>
        /* Контейнер за календара */
        .calendar-container {
            width: 80%;
            max-width: 900px;
            margin: 0 auto;
            border: 1px solid #ddd;
            border-radius: 10px;
            background-color: white;
            padding: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            margin-bottom: 20px;
        }

        .calendar-title {
            font-size: 24px;
            font-weight: bold;
            margin: 0;
        }

        button {
            background-color: #f0f0f0;
            border: none;
            font-size: 18px;
            cursor: pointer;
            padding: 10px;
            border-radius: 5px;
        }

            button:hover {
                background-color: #ddd;
            }

        .days-of-week {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            margin-top: 10px;
        }

        .day {
            text-align: center;
            font-weight: bold;
        }

        .calendar-days {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
            margin-top: 10px;
        }

        .calendar-day {
            width: 40px;
            height: 40px;
            text-align: center;
            line-height: 40px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 16px;
        }

            .calendar-day:hover {
                background-color: #ddd;
            }

            .calendar-day.empty {
                background-color: #f0f0f0;
            }

            /* Добавяне на клас за избраната дата */
            .calendar-day.selected {
                background-color: red;
                color: white;
            }

        #reservationForm {
            width: 100%;
            padding: 20px;
            border-radius: 10px;
            background-color: #f9f9f9;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
            display: none;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .btn-primary {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 5px 15px;
            cursor: pointer;
        }

            .btn-primary:hover {
                background-color: #0056b3;
            }

    </style>
</head>
<body>

    <div class="calendar-container">
        <div class="calendar-header">
            <button class="prev-month">&#8249;</button>
            <h2 class="calendar-title">Януари 2022</h2>
            <button class="next-month">&#8250;</button>
        </div>

        <div class="calendar-body">
            <div class="days-of-week">
                <div class="day">Пон</div>
                <div class="day">Вто</div>
                <div class="day">Сря</div>
                <div class="day">Чет</div>
                <div class="day">Пет</div>
                <div class="day">Съб</div>
                <div class="day">Нед</div>
            </div>

            <div class="calendar-days">
                <!-- Дните от месеца ще бъдат добавени тук -->
            </div>
        </div>
    </div>

    <!-- Форма за резервация -->
    <div id="reservationForm">
        <h3>Резервирай събитие</h3>
        <form asp-action="CreateReservationRequest" method="post">
            <input type="hidden" id="userEmail" value="@User.Identity?.Name" />

            <label>Дата:</label>
            <input type="date" asp-for="RequestedDate" class="form-control" id="eventDate" />

            <label>Тип събитие:</label>
            <input type="text" asp-for="EventType" class="form-control" id="eventType" />

            <button type="submit" class="btn btn-primary">Изпрати заявка</button>
        </form>
    </div>

    <script>
        const months = ['Януари', 'Февруари', 'Март', 'Април', 'Май', 'Юни', 'Юли', 'Август', 'Септември', 'Октомври', 'Ноември', 'Декември'];
        let currentDate = new Date();
        let selectedDate = null;

        function renderCalendar() {
            const month = currentDate.getMonth();
            const year = currentDate.getFullYear();

            document.querySelector('.calendar-title').textContent = `${months[month]} ${year}`;

            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);

            const firstDayOfWeek = firstDay.getDay(); // ден от седмицата (0 = неделя)
            const lastDate = lastDay.getDate();

            const calendarDays = document.querySelector('.calendar-days');
            calendarDays.innerHTML = '';

            const startIndex = firstDayOfWeek === 0 ? 6 : firstDayOfWeek - 1;

            for (let i = 0; i < startIndex; i++) {
                const emptyDay = document.createElement('div');
                emptyDay.classList.add('calendar-day', 'empty');
                calendarDays.appendChild(emptyDay);
            }

            for (let i = 1; i <= lastDate; i++) {
                const dayElement = document.createElement('div');
                dayElement.classList.add('calendar-day');
                dayElement.textContent = i;

                dayElement.addEventListener('click', () => {
                            let selectedDate = new Date(Date.UTC(year, month, i));
        let formattedDate = selectedDate.toLocaleDateString("sv-SE"); // "2025-08-08"



                    $('#eventDate').val(formattedDate);
                    $('#reservationForm').show();
                });

                calendarDays.appendChild(dayElement);
            }

            loadApprovedReservations(); // зарежда след всяко рендериране
        }

        function loadApprovedReservations() {
            $.ajax({
                url: 'https://localhost:7186/api/eventreservationrequestsapi/approved',
                method: 'GET',
                success: function (data) {
                    data.forEach(function (reservation) {
                        const reservedDate = new Date(reservation.requestedDate);
                        if (isNaN(reservedDate)) return;

                        const reservedDay = reservedDate.getDate();
                        const reservedMonth = reservedDate.getMonth();
                        const reservedYear = reservedDate.getFullYear();

                        if (reservedMonth === currentDate.getMonth() && reservedYear === currentDate.getFullYear()) {
                            document.querySelectorAll('.calendar-day').forEach(el => {
                                if (!el.classList.contains('empty') && Number(el.textContent) === reservedDay) {
                                    el.classList.add('booked');
                                    el.title = reservation.eventType;
                                }
                            });
                        }
                    });
                },
                error: function () {
                    console.error('Неуспешно зареждане на одобрени резервации.');
                }
            });
        }

        document.querySelector('.prev-month').addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar();
        });

        document.querySelector('.next-month').addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar();
        });

        $('#reservationForm').on('submit', function (e) {
            e.preventDefault();

            const eventDate = $('#eventDate').val();
            const eventType = $('#eventType').val();
            const userEmail = $('#userEmail').val();

            if (!eventDate || !eventType || !userEmail) {
                alert("Моля, попълнете всички полета!");
                return;
            }

            $.ajax({
                url: 'https://localhost:7186/api/EventReservationRequestsApi',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    requestedDate: eventDate,
                    eventType: eventType,
                    userEmail: userEmail
                }),
                success: function () {
                    alert('Заявката е изпратена успешно!');
                    $('#reservationForm').hide();
                    renderCalendar(); // презареждаме календара
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                    alert('Грешка при изпращане на заявка.');
                }
            });
        });

        renderCalendar(); // Първоначално зареждане
    </script>

</body>
</html>
