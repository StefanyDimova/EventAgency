@using EventAgency.Web.ViewModels.Product
@model IEnumerable<AllProductsViewModel>

@{
    ViewData["Title"] = "Продукти";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Продукти</h2>

    <!-- Вмъкваме частта за търсене и филтриране -->
    <div class="row">
        <div class="col-md-6">
            @Html.Partial("_SearchBarPartial") <!-- Част за търсене -->
        </div>

        <div class="col-md-6">
            @Html.Partial("_FilterPartialView", Model) <!-- Част за филтриране -->
        </div>
    </div>

    <!-- Карти за продуктите -->
    <div class="row row-cols-1 row-cols-md-3 g-4" id="productList">
        @foreach (AllProductsViewModel product in Model)
        {
            <div class="col product-card">
                <div class="card h-100 shadow rounded-4">
                    <img src="@product.ImageUrl" class="card-img-top img-fluid rounded-top-4" alt="@product.Name" style="max-width: 100%; max-height: 300px; object-fit: contain;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>

                        <div class="mb-2">
                            <span class="fw-bold">Цена:</span>
                            <span class="product-price">@product.Price.ToString("0.00") лв.</span> /
                            <span>@product.PriceInEuro.ToString("0.00") €</span>
                        </div>

                        <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="input-group input-group-sm me-2" style="width: 100px;">
                                    <input type="number" name="quantity" value="1" min="1" class="form-control text-center" />
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">
                                        Детайли
                                    </a>
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-cart-plus"></i> Добави
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-4" id="pagination">
        <!-- Навигационни бутони ще бъдат добавени тук динамично с JS -->
    </div>

</div>
<script src="~/js/pagination.js"></script> <!-- Път към JS файла -->
<script src="~/js/search.js"></script> <!-- Път към JS файла -->
<script src="~/js/filter.js"></script> <!-- Път към JS файла -->
