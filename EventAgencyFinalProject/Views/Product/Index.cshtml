@using EventAgency.Web.ViewModels.Product
@model IEnumerable<AllProductsViewModel>

@{
    ViewData["Title"] = "Продукти";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Продукти</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (AllProductsViewModel product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow rounded-4">
                    <img src="@product.ImageUrl" class="card-img-top img-fluid rounded-top-4" alt="@product.Name" style="max-width: 100%; max-height: 300px; object-fit: contain;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>

                        <div class="mb-2">
                            <span class="fw-bold">Цена:</span>
                            <span>@product.Price.ToString("0.00") лв.</span> /
                            <span>@product.PriceInEuro.ToString("0.00") €</span>
                        </div>

                        <div class="mt-auto d-flex justify-content-between">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">Детайли</a>

                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-success btn-sm">Добави в количка</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>