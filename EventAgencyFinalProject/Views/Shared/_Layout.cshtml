<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventAgency</title>

    <!-- Bootstrap и FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Стилове -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Event/allEvents.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Event/addEvent.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Event/eventDetails.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #ff69b4;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white" asp-controller="Home" asp-action="Index"> SisiPartyAgency</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <!-- Dropdown Menu -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="menuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Меню
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Index">
                                        <i class="fas fa-home me-2"></i>Начало
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Event" asp-action="Index">
                                        <i class="fas fa-calendar-alt me-2"></i>Събития
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Event" asp-action="Add">
                                        <i class="fas fa-plus me-2"></i>Добави събитие
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Product" asp-action="Index">
                                        <i class="fa-solid fa-store me-2"></i>Продукти
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Product" asp-action="Add">
                                        <i class="fas fa-plus me-2"></i>Добави продукт
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="About">
                                        <i class="fas fa-info-circle me-2"></i>За нас
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Cart" asp-action="Index">
                                        <i class="fas fa-shopping-cart me-2"></i>Количка
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Login/Register or Profile/Logout -->
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Manage/Index">
                                    <i class="fas fa-user me-1"></i>@User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" asp-route-returnUrl="@Url.Action("Index", "Home")" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-white">
                                        <i class="fas fa-sign-out-alt me-1"></i>Изход
                                    </button>
                                </form>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">
                                    <i class="fas fa-sign-in-alt me-1"></i>Вход
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register">
                                    <i class="fas fa-user-plus me-1"></i>Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
