<div class="row mb-4">
    <!-- Филтър по минимална цена -->
    <div class="col-md-6">
        <label for="minPrice">Минимална цена (лв.)</label>
        <input type="number" id="minPrice" class="form-control" placeholder="Минимална цена" onchange="filterProducts()">
    </div>

    <!-- Филтър по максимална цена -->
    <div class="col-md-6">
        <label for="maxPrice">Максимална цена (лв.)</label>
        <input type="number" id="maxPrice" class="form-control" placeholder="Максимална цена" onchange="filterProducts()">
    </div>
</div>

