@page
@model LoginModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg border-0" style="width: 400px; background-color: #fff0f6;">
        <div class="card-header text-center text-white" style="background-color: #ff69b4;">
            <h3 class="mb-0 fw-bold">Welcome Back! 🎈</h3>
            <small>Please login to your party account</small>
        </div>
        <div class="card-body">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label text-pink fw-semibold">Email</label>
                    <input asp-for="Input.Email" class="form-control border-pink" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label text-pink fw-semibold">Password</label>
                    <input asp-for="Input.Password" class="form-control border-pink" placeholder="password" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label text-pink">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <div class="d-grid mb-3">
                    <button id="login-submit" type="submit" class="btn text-white fw-bold" style="background-color: #ff69b4;">
                        Log in
                    </button>
                </div>

                <div class="text-center">
                    
                    <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none text-muted">Register as a new user</a></p>
                   
                </div>
            </form>
        </div>

        @if (Model.ExternalLogins?.Count > 0)
        {
            <div class="card-footer bg-white text-center">
                <p class="mb-2 text-pink fw-semibold">Or login with:</p>
                <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <button type="submit" class="btn btn-outline-pink me-2 mb-2" name="provider" value="@provider.Name">
                            @provider.DisplayName
                        </button>
                    }
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .text-pink {
        color: #ff1493;
    }

    .border-pink {
        border: 2px solid #ffb6c1;
    }

    .btn-outline-pink {
        color: #ff69b4;
        border-color: #ff69b4;
    }

        .btn-outline-pink:hover {
            background-color: #ff69b4;
            color: white;
        }
</style>
