@model EventAgency.Web.ViewModels.Admin.ProductManagement.ProductEditInputModel

@{
    ViewData["Title"] = "Редактирай продукт";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productDetails.css" />
}

<div class="container py-4">
    <h2 class="text-center mb-4 text-pink">Редактирай продукт</h2>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-pink">Име</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-semibold text-pink">URL на снимка</label>
                    <input asp-for="ImageUrl" class="form-control" />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold text-pink">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-semibold text-pink">Цена (лв)</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label fw-semibold text-pink">Налично количество</label>
                    <input asp-for="Quantity" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-bold">Категория</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                        <option value="">-- Избери главна категория --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SubCategoryId" class="form-label fw-bold">Подкатегория</label>
                    <select asp-for="SubCategoryId" class="form-select">
                        <option value="">-- Моля, изберете категория първо --</option>
                    </select>
                    <span asp-validation-for="SubCategoryId" class="text-danger small"></span>
                </div>


                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">Запази промените</button>
                    <a asp-action="Index" class="btn btn-secondary">Назад към продуктите</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            const selectedSubCategoryId = '@Model.SubCategoryId';

            function loadSubcategories(selectedParentId, selectedSubcategoryId) {
                if (selectedParentId) {
                    $.ajax({
                        url: '/Product/GetSubcategories',
                        type: 'GET',
                        data: { parentId: selectedParentId },
                        success: function (subcategories) {
                            const $subCatSelect = $('#SubCategoryId');
                            $subCatSelect.empty();

                            if (subcategories.length === 0) {
                                $subCatSelect.append('<option value="">-- Няма подкатегории --</option>');
                            } else {
                                $subCatSelect.append('<option value="">-- Избери подкатегория --</option>');
                                $.each(subcategories, function (i, subcat) {
                                    const isSelected = subcat.id == selectedSubcategoryId ? 'selected' : '';
                                    $subCatSelect.append('<option value="' + subcat.id + '" ' + isSelected + '>' + subcat.name + '</option>');
                                });
                            }
                        },
                        error: function () {
                            alert('Възникна грешка при зареждане на подкатегории.');
                        }
                    });
                }
            }

            $('#CategoryId').change(function () {
                const selectedCategoryId = $(this).val();
                loadSubcategories(selectedCategoryId, null);
            });

            // Автоматично зареждане при зареждане на страницата
            const initialCategoryId = $('#CategoryId').val();
            loadSubcategories(initialCategoryId, selectedSubCategoryId);
        });
    </script>
}


