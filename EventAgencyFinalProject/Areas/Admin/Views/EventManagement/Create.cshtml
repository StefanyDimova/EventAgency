@using EventAgency.Web.ViewModels.Event
@model EventFormInputModel

@{
    ViewData["Title"] = "Добавяне на събитие";
}

<h2 class="text-center mb-4">Добави ново събитие</h2>

<div class="row justify-content-center">
    <div class="col-md-8">
        <form asp-area="Admin" asp-action="Create" method="post" class="p-4 rounded shadow" style="background-color: #fffafc;">
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold fs-5"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold fs-5"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label fw-bold fs-5"></label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-area="Admin" asp-controller="Event" asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Назад
                </a>

                <button type="submit" class="btn btn-success">
                    <i class="fas fa-plus me-1"></i>Добави събитие
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
