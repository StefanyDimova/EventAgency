@using EventAgency.Web.ViewModels.Admin.EventManagement
@model IEnumerable<EventManagementIndexViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">
    <h1 class="text-center text-warning fw-bold">Управление на събития</h1>
    <p class="text-center text-muted">Създавайте, актуализирайте и изтривайте събития.</p>

    <div class="d-flex justify-content-between mb-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary fw-bold">
            <i class="bi bi-arrow-left"></i> Назад към таблото
        </a>
        <a asp-action="Create" class="btn btn-success fw-bold shadow-lg">
            <i class="bi bi-plus-circle"></i> Добави ново събитие
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            <i class="bi bi-exclamation-circle"></i> No events available. Click "Add New Event" to create one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-light table-hover shadow-lg rounded-3">
                <thead class="thead-light">
                    <tr class="text-warning text-center">
                        <th scope="col">Име</th>
                        <th scope="col">Снимка</th>
                        <th scope="col">Описание</th>
                        <th scope="col">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (EventManagementIndexViewModel eventItem in Model)
                    {
                        <tr class="align-middle text-center @(eventItem.IsDeleted ? "table-danger" : "")">
                            <td class="fw-bold">
                                @eventItem.Name
                                @if (eventItem.IsDeleted)
                                {
                                    <span class="badge bg-danger ms-2">Deleted</span>
                                }
                            </td>
                            <td>
                                <img src="@eventItem.ImageUrl" alt="@eventItem.Name" class="img-fluid" style="max-width: 100px;">
                            </td>
                            <td>@eventItem.Description</td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@eventItem.Id" class="btn btn-primary btn-sm fw-bold">
                                        <i class="bi bi-pencil-square"></i> Редактирай
                                    </a>

                                    <a asp-action="ToggleDelete" asp-route-id="@eventItem.Id" class="btn @(eventItem.IsDeleted ? "btn-warning" : "btn-danger") btn-sm fw-bold">
                                        <i class="bi @(eventItem.IsDeleted ? "bi-arrow-clockwise" : "bi-trash")"></i>
                                        @(eventItem.IsDeleted ? "Възстанови" : "Изтрий")
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table> 
        </div>
    }
</div>

